# Copy to .env (or just export these) before starting the server.

# --- answer generation -------------------------------------------------
# Without a key the service still runs: retrieval works and answers are
# extractive (quoted passages) instead of generated.
ANTHROPIC_API_KEY=

# Model used for answers. Defaults to claude-opus-5.
DOCQA_MODEL=claude-opus-5
# Reasoning effort: low | medium | high | xhigh | max
DOCQA_EFFORT=medium
DOCQA_MAX_TOKENS=4000

# --- storage -----------------------------------------------------------
DOCQA_DATA_DIR=./data
DOCQA_MAX_UPLOAD_MB=25

# --- chunking and retrieval -------------------------------------------
DOCQA_CHUNK_WORDS=180
DOCQA_CHUNK_OVERLAP=45
DOCQA_CANDIDATE_K=40
DOCQA_TOP_K=6
DOCQA_NEIGHBOUR_WINDOW=1

# --- optional dense retrieval -----------------------------------------
# Requires: pip install sentence-transformers
DOCQA_EMBEDDINGS=false
DOCQA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
